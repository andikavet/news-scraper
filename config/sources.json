{
  "sources": [
    {
      "name": "PortalX",
      "pagination_type": "url_params",
      "url_template": "http://localhost:8899/portalx_listing.html?page={page}",
      "selectors": {
        "container": "li.article-item",
        "title": "h2 > a",
        "link": "h2 > a",
        "date": ".date-time",
        "next_button": null
      },
      "avg_page_per_month": 30,
      "sleep": {
        "min": 1.0,
        "max": 3.0
      },
      "max_retries": 3,
      "enabled_layers": [
        1,
        3
      ],
      "scrolls_per_page": 1,
      "enabled": true
    }
  ]
}